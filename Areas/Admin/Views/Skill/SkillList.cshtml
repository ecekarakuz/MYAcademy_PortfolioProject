@model List<Skill>
@{
    ViewData["Title"] = "Yetenek Listesi";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}
<main class="page-content-area">

    <div class="content-header-row">
        <div>
            <h1 class="page-title">Yeteneklerim</h1>
            <p class="page-subtitle">Portfolyo sitenizde gösterilecek yetenekleri ve seviyelerini yönetin.</p>
        </div>
        <div class="header-actions">
            <a asp-action="CreateSkill" class="btn-pastel-primary">
                <i class="bi bi-plus-circle-fill"></i>
                <span>Yeni Yetenek Ekle</span>
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="data-table-card">
        <div class="table-responsive-wrapper">
            <table class="custom-admin-table">
                <thead>
                    <tr>
                        <th style="width: 70px;">ID</th>
                        <th>Yetenek</th>
                        <th style="width: 280px;">Seviye</th>
                        <th style="text-align: right; width: 140px;">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="col-id">#@item.SkillId</td>
                            <td>
                                <span class="exp-title-text">@item.Title</span>
                                <small class="text-muted d-block" style="font-size:0.75rem;">@item.Description</small>
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="progress flex-grow-1" style="height:10px;">
                                        <div class="progress-bar" role="progressbar"
                                             style="width:@item.Level%"
                                             aria-valuenow="@item.Level" aria-valuemin="0" aria-valuemax="100"></div>
                                    </div>
                                    <span class="order-badge">%@item.Level</span>
                                </div>
                            </td>
                            <td style="text-align: right;">
                                <div class="row-actions-group justify-content-end">
                                    <a asp-action="UpdateSkill" asp-route-id="@item.SkillId"
                                       class="btn-action-icon btn-edit" title="Güncelle">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <form asp-action="DeleteSkill" asp-route-id="@item.SkillId"
                                          method="post" class="d-inline">
                                        <button type="button" class="btn-action-icon btn-delete"
                                                title="Sil" onclick="confirmDelete(this)">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="4" style="text-align:center;">Henüz yetenek eklenmemiş.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</main>
