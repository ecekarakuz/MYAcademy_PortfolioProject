@model MYAcademy_PortfolioProject.Entities.HeroSectioncs

<!-- 5. About Me Section -->
<section id="about" class="bg-white border-top border-bottom">
    <div class="container">
        <div class="row align-items-center gy-5">
            <div class="col-lg-5 reveal-on-scroll">
                <div class="about-img-wrap">
                    @if (!string.IsNullOrEmpty(Model.MainImageUrl))
                    {
                        <img src="@Model.MainImageUrl" alt="@Model.Title" class="w-100"
                             style="height: 540px; object-fit: cover; object-position: center top;">
                    }
                    else
                    {
                        <div class="d-flex align-items-center justify-content-center bg-light" style="height: 540px;">
                            <i class="bi bi-person" style="font-size: 6rem; opacity: 0.3;"></i>
                        </div>
                    }
                    <div class="p-3 bg-light border-top d-flex align-items-center justify-content-between">
                        <span class="small text-muted font-heading">@Model.Title</span>
                        @if (!string.IsNullOrEmpty((string)ViewBag.Location))
                        {
                            <span class="badge bg-secondary-subtle text-dark fw-medium">
                                <i class="bi bi-geo-alt me-1"></i>@ViewBag.Location
                            </span>
                        }
                    </div>
                </div>
            </div>

            <div class="col-lg-7 ps-lg-5 reveal-on-scroll">
                <div class="eyebrow-badge">
                    <i class="bi bi-person-lines-fill"></i> BENİ TANIYIN
                </div>
                <h2 class="section-title">
                    Teknolojiye Tutkuyla Bağlı Bir Yolculuk.
                </h2>
                <div class="text-muted fs-5 mb-4 lh-base">
                    <p class="mb-3">
                        Merhaba, ben <strong>@Model.Title</strong>. Yazılım geliştirme, yazılım eğitimi ve modern teknolojiler üzerine çalışan bir yazılım geliştiricisiyim. Özellikle <strong>.NET ekosistemi</strong>, yazılım mimarileri ve yapay zeka destekli uygulamalar geliştirme alanlarında çalışmalar yürütüyorum.
                    </p>
                    <p class="mb-4">
                        Teknolojinin yalnızca kod yazmaktan ibaret olmadığına; aynı zamanda problem çözmek, değer üretmek ve bilgiyi paylaşmak olduğuna inanıyorum. Geliştirdiğim projeler ve hazırladığım eğitimlerle yazılım dünyasına katkı sağlamayı hedefliyorum.
                    </p>
                </div>

                <!-- Rakamlar artık veritabanından geliyor -->
                <div class="row g-4 pt-2 pb-4 border-top border-bottom mb-4">
                    <div class="col-4">
                        <div class="stat-number">@ViewBag.ProjectCount</div>
                        <div class="stat-label">Aktif Proje</div>
                    </div>
                    <div class="col-4">
                        <div class="stat-number">@ViewBag.SkillCount</div>
                        <div class="stat-label">Yetenek</div>
                    </div>
                    <div class="col-4">
                        <div class="stat-number">@ViewBag.ExperienceCount</div>
                        <div class="stat-label">Deneyim</div>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-3">
                    <a href="#projects" class="btn-sage">
                        <i class="bi bi-code-slash"></i>
                        <span>Projelerimi İncele</span>
                    </a>
                    <a href="#contact" class="btn-secondary-custom">
                        <span>Bana Ulaşın</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
