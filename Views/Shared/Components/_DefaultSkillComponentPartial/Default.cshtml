@model List<Skill>

@if (Model.Any())
{
    <section id="skills">
        <div class="container">
            <div class="section-header text-center mx-auto reveal-on-scroll" style="max-width: 680px;">
                <div class="eyebrow-badge">
                    <i class="bi bi-stack"></i> TEKNOLOJİ YIĞINIM
                </div>
                <h2 class="section-title">
                    Kullandığım Teknolojiler ve Uzmanlık Alanlarım
                </h2>
                <p class="section-description mx-auto">
                    Bir fikrin hayata geçirilmesinden ölçeklenebilir bir yazılım ürününe dönüşmesine kadar farklı teknolojilerle çalışıyorum.
                </p>
            </div>

            <div class="row g-4">
                @foreach (var skill in Model)
                {
                    <div class="col-md-6 col-lg-4 reveal-on-scroll">
                        <div class="skill-card">
                            <div class="skill-icon-box">
                                <i class="@skill.IconUrl"></i>
                            </div>
                            <h3 class="h5 fw-bold mb-3">@skill.Title</h3>
                            <p class="text-muted small mb-4">@skill.Description</p>

                            <div class="d-flex justify-content-between small mb-1">
                                <span class="text-muted">Seviye</span>
                                <strong>%@skill.Level</strong>
                            </div>
                            <div class="progress" style="height: 8px;">
                                <div class="progress-bar" role="progressbar"
                                     style="width:@skill.Level%"
                                     aria-valuenow="@skill.Level" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}
