@model Project
@{
    ViewData["Title"] = "Proje Güncelle";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}
<main class="page-content-area">

    <div class="content-header-row">
        <div>
            <h1 class="page-title">Proje Güncelle</h1>
            <p class="page-subtitle">Proje bilgilerini düzenleyin.</p>
        </div>
    </div>

    <div class="side-drawer-card">
        <form asp-action="UpdateProject" method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="ProjectId" />
            <div class="row g-3">

                <div class="col-md-6">
                    <label asp-for="ProjectTitle" class="form-label-custom">
                        Proje Adı <span class="required-star">*</span>
                    </label>
                    <input asp-for="ProjectTitle" class="form-control-custom" />
                    <span asp-validation-for="ProjectTitle" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="CategoryId" class="form-label-custom">
                        Kategori <span class="required-star">*</span>
                    </label>
                    <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-control-custom">
                        <option value="0">-- Kategori Seç --</option>
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Description" class="form-label-custom">
                        Açıklama <span class="required-star">*</span>
                    </label>
                    <textarea asp-for="Description" class="form-control-custom" rows="3"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Technologies" class="form-label-custom">Teknolojiler</label>
                    <input asp-for="Technologies" class="form-control-custom" />
                    <span asp-validation-for="Technologies" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label class="form-label-custom">Proje Görseli (boş bırakırsan mevcut görsel kalır)</label>
                    <input type="file" name="imageFile" id="imageFile" class="form-control-custom"
                           accept=".jpg,.jpeg,.png,.webp" />
                    @Html.ValidationMessage("imageFile", new { @class = "text-danger" })

                    @if (!string.IsNullOrEmpty(Model.ImagePath))
                    {
                        <div style="margin-top:10px;">
                            <small class="text-muted d-block">Mevcut görsel:</small>
                            <img id="currentImage" src="@Model.ImagePath" alt="Mevcut görsel"
                                 style="max-width:220px;border-radius:10px;" />
                        </div>
                    }
                    <img id="imagePreview" src="#" alt="Önizleme"
                         style="display:none;margin-top:10px;max-width:220px;border-radius:10px;" />
                </div>

                <div class="col-12">
                    <div class="form-check">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label ms-1">
                            Aktif (sitede göster)
                        </label>
                    </div>
                </div>

                <div class="col-12 d-flex gap-2">
                    <a asp-action="ProjectList" class="btn-pastel-secondary" style="padding: 8px 14px;">İptal</a>
                    <button type="submit" class="btn-pastel-primary" style="padding: 8px 20px;">
                        <i class="bi bi-check-lg"></i>
                        <span>Güncelle</span>
                    </button>
                </div>
            </div>
        </form>
    </div>
</main>

<script>
    document.getElementById('imageFile').addEventListener('change', function () {
        var preview = document.getElementById('imagePreview');
        var current = document.getElementById('currentImage');
        if (this.files && this.files[0]) {
            preview.src = URL.createObjectURL(this.files[0]);
            preview.style.display = 'block';
            if (current) current.style.display = 'none';
        } else {
            preview.style.display = 'none';
            if (current) current.style.display = '';
        }
    });
</script>