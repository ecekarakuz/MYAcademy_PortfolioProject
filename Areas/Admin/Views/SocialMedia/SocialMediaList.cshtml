@model List<SocialMedia>
@{
    ViewData["Title"] = "Sosyal Medya Listesi";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}
<main class="page-content-area">

    <div class="content-header-row">
        <div>
            <h1 class="page-title">Sosyal Medya</h1>
            <p class="page-subtitle">Sitenizde görünecek sosyal medya bağlantılarını yönetin.</p>
        </div>
        <div class="header-actions">
            <a asp-action="CreateSocialMedia" class="btn-pastel-primary">
                <i class="bi bi-plus-circle-fill"></i>
                <span>Yeni Bağlantı Ekle</span>
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="data-table-card">
        <div class="table-responsive-wrapper">
            <table class="custom-admin-table">
                <thead>
                    <tr>
                        <th style="width: 70px;">ID</th>
                        <th style="width: 70px;">İkon</th>
                        <th>Platform</th>
                        <th>Bağlantı</th>
                        <th style="text-align: right; width: 140px;">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="col-id">#@item.SocialMediaId</td>
                            <td><i class="@item.Icon" style="font-size:1.3rem;"></i></td>
                            <td><span class="exp-title-text">@item.Platform</span></td>
                            <td><a href="@item.Url" target="_blank" rel="noopener">@item.Url</a></td>
                            <td style="text-align: right;">
                                <div class="row-actions-group justify-content-end">
                                    <a asp-action="UpdateSocialMedia" asp-route-id="@item.SocialMediaId"
                                       class="btn-action-icon btn-edit" title="Güncelle">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <form asp-action="DeleteSocialMedia" asp-route-id="@item.SocialMediaId"
                                          method="post" class="d-inline">
                                        <button type="button" class="btn-action-icon btn-delete"
                                                title="Sil" onclick="confirmDelete(this)">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" style="text-align:center;">Henüz sosyal medya bağlantısı eklenmemiş.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</main>