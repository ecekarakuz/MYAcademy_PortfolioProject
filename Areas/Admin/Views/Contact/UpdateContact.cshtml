@model Contact
@{
    ViewData["Title"] = "İletişim";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}
<main class="page-content-area">

    <div class="content-header-row">
        <div>
            <h1 class="page-title">İletişim Bilgileri</h1>
            <p class="page-subtitle">Sitenizin iletişim bölümünde görünen bilgileri yönetin.</p>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <div class="side-drawer-card">
        <form asp-action="UpdateContact" method="post">
            <input type="hidden" asp-for="ContactId" />
            <div class="row g-3">

                <div class="col-md-6">
                    <label asp-for="Title" class="form-label-custom">
                        Başlık <span class="required-star">*</span>
                    </label>
                    <input asp-for="Title" class="form-control-custom" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Email" class="form-label-custom">
                        E-posta <span class="required-star">*</span>
                    </label>
                    <input asp-for="Email" class="form-control-custom" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="PhoneNumber" class="form-label-custom">
                        Telefon <span class="required-star">*</span>
                    </label>
                    <input asp-for="PhoneNumber" class="form-control-custom" />
                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Location" class="form-label-custom">
                        Konum <span class="required-star">*</span>
                    </label>
                    <input asp-for="Location" class="form-control-custom" />
                    <span asp-validation-for="Location" class="text-danger"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Description" class="form-label-custom">
                        Açıklama <span class="required-star">*</span>
                    </label>
                    <textarea asp-for="Description" class="form-control-custom" rows="3"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="col-12 d-flex gap-2">
                    <button type="submit" class="btn-pastel-primary" style="padding: 8px 20px;">
                        <i class="bi bi-check-lg"></i>
                        <span>Kaydet</span>
                    </button>
                </div>
            </div>
        </form>
    </div>
</main>